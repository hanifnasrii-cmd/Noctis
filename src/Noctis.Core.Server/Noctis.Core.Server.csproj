<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The built-in OpenSubsonic server (Kestrel, self-signed cert, SQLite accounts).
         Split from Noctis.Core so Core stays free of ASP.NET: the Android head
         references Core and cannot take the Microsoft.AspNetCore.App framework. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis</RootNamespace>
    <AssemblyName>Noctis.Core.Server</AssemblyName>
    <NoWarn>CS0067;MVVMTK0039;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noctis" />
    <InternalsVisibleTo Include="Noctis.Tests" />
    <InternalsVisibleTo Include="noctis-server" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctis.Core\Noctis.Core.csproj" />
  </ItemGroup>

</Project>
