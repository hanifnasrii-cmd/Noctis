<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Controls.CoverFlowCard"
             x:Name="Root"
             ClipToBounds="False">

    <UserControl.Styles>
        <!-- Artist link in the caption: plain text look, no Fluent hover square, no global zoom. -->
        <Style Selector="Button.flow-card-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.flow-card-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.flow-card-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.flow-card-link:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.flow-card-link:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
    </UserControl.Styles>

    <!-- Three rings, each doing ONE job:
         Shadow  - unclipped, carries the BoxShadow (ClipToBounds would cut it).
         Frame   - draws the 2px light rim only; NOT clipped, so the rim's rounded
                   corners render at full strength (a clipped stroke loses its corner
                   arcs, worse still under the side cards' 3D tilt + scale).
         Clip    - clips the slab at radius - rim, inside the rim.
         Inside: ONE glass slab (CardGlass) under everything - the artwork sits inset on
         it with its own rounded corners and the caption rests on the same surface, the
         way the reference cards read as a single piece of frosted glass. -->
    <Border x:Name="Shadow"
            CornerRadius="{Binding #Root.CardCornerRadius}"
            BoxShadow="0 18 44 0 #8C000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border x:Name="Frame"
                CornerRadius="{Binding #Root.CardCornerRadius}"
                BorderThickness="2"
                BorderBrush="#8CFFFFFF">
          <Border x:Name="Clip"
                  CornerRadius="{Binding #Root.InnerCornerRadius}"
                  ClipToBounds="True">
            <Panel>
                <!-- The slab. Liquid Glass OFF: an opaque grey fill (it must not be
                     see-through then: the neighbouring cards pass behind the centre card
                     and would show as sharp notches). ON: frosts and tints what is beneath. -->
                <controls:GlassPanel x:Name="CardGlass"
                                     Background="#FF343440"
                                     GlassTint="#2E2E38"
                                     GlassTintOpacity="{Binding #Root.CardTintOpacity}"
                                     BlurRadius="{Binding #Root.CardBlurRadius}"
                                     EdgeThickness="0" />
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Artwork: square, inset on the slab with its own rounded corners -->
                    <Border Grid.Row="0" x:Name="ArtworkFrame"
                            Margin="{Binding #Root.ArtworkMargin}"
                            CornerRadius="{Binding #Root.ArtworkCornerRadius}"
                            ClipToBounds="True">
                    <Panel x:Name="ArtworkPanel"
                           Width="{Binding #Root.ArtworkSize}"
                           Height="{Binding #Root.ArtworkSize}">
                        <Border Background="#2A2A31" />
                        <TextBlock Text="{loc:T CoverFlow.Text}"
                                   FontSize="{Binding #Root.PlaceholderFontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.15"
                                   IsVisible="{Binding #Root.ArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <controls:CachedImage SourcePath="{Binding #Root.ArtworkPath}"
                                              DecodeWidth="{Binding #Root.DecodeWidth}"
                                              Stretch="UniformToFill"
                                              RenderOptions.BitmapInterpolationMode="HighQuality"
                                              IsVisible="{Binding #Root.ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ContentPresenter Content="{Binding #Root.Overlay}" />
                    </Panel>
                    </Border>

                    <!-- Frosted caption strip: title + artist, every card carries its own -->
                    <!-- Caption: title + artist resting on the slab under the artwork -->
                    <Border Grid.Row="1" x:Name="Caption"
                            Padding="16,10,16,18">
                        <StackPanel Spacing="2">
                            <!-- Auto columns, not a horizontal StackPanel: that measures the
                                 title at infinite width and CharacterEllipsis never trims. -->
                            <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Grid.Column="0"
                                           Text="{Binding #Root.Title}"
                                           FontSize="{Binding #Root.TitleFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           MaxWidth="{Binding #Root.TitleMaxWidth}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Classes="explicit-badge compact"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding #Root.IsExplicit}">
                                    <TextBlock Text="E"
                                               Classes="explicit-badge-text compact"
                                               FontSize="10"
                                               Opacity="0.9" />
                                </Border>
                            </Grid>
                            <!-- Artist: a link when the host gives a command, plain text otherwise -->
                            <TextBlock x:Name="ArtistText"
                                       Text="{Binding #Root.Artist}"
                                       FontSize="{Binding #Root.ArtistFontSize}"
                                       Foreground="#C9FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"
                                       MaxWidth="{Binding #Root.TitleMaxWidth}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding #Root.ArtistCommand, Converter={x:Static ObjectConverters.IsNull}}" />
                            <Button x:Name="ArtistLinkButton"
                                    Classes="flow-card-link"
                                    Command="{Binding #Root.ArtistCommand}"
                                    IsVisible="{Binding #Root.ArtistCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding #Root.Artist}"
                                           FontSize="{Binding #Root.ArtistFontSize}"
                                           Foreground="#C9FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           MaxWidth="{Binding #Root.TitleMaxWidth}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Depth dimming for cards away from the centre -->
                <Border x:Name="DimOverlay"
                        Background="#000"
                        Opacity="{Binding #Root.Dim}"
                        IsHitTestVisible="False" />
            </Panel>
          </Border>
        </Border>
    </Border>

</UserControl>
