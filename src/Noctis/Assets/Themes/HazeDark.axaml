<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Haze (dark) — deep plum/indigo, lifted card surfaces, muted lavender secondary text.
        Generated from one shared spec (all six new themes carry the same key set;
        ThemeOverlayParityTests pins that). Merged on top of the base Dark ThemeDictionary.
    -->

    <!-- Accent palette (theme default; App.SetAccent overlays the user's pick on top) -->
    <Color x:Key="SystemAccentColor">#874CF2</Color>
    <Color x:Key="SystemAccentColorDark1">#7240CD</Color>
    <Color x:Key="SystemAccentColorDark2">#5E35A9</Color>
    <Color x:Key="SystemAccentColorDark3">#4A2985</Color>
    <Color x:Key="SystemAccentColorLight1">#9966F3</Color>
    <Color x:Key="SystemAccentColorLight2">#AB81F5</Color>
    <Color x:Key="SystemAccentColorLight3">#BD9CF7</Color>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#874CF2" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush2" Color="#9966F3" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="#874CF2" />
    <!-- Primary action buttons: accent-to-hue-shifted gradient. App.SetAccent rebuilds this
         from whatever accent the user picks; the hue shift below is the theme's instruction. -->
    <LinearGradientBrush x:Key="AccentButtonBackground" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#874CF2" Offset="0" />
        <GradientStop Color="#C24CE0" Offset="1" />
    </LinearGradientBrush>
    <x:Double x:Key="AccentButtonGradientHueShift">40</x:Double>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AccentColorBrushDark1" Color="#7240CD" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B393FF" />
    <SolidColorBrush x:Key="AccentTextExactBrush" Color="#B393FF" />
    <SolidColorBrush x:Key="NowPlayingRowBrush" Color="#874CF2" />
    <SolidColorBrush x:Key="NowPlayingRowForegroundBrush" Color="#FFFFFF" />

    <!-- Toggle switch fill -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#874CF2" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9966F3" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#7240CD" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDragging" Color="#9966F3" />
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#3A3158" />
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#F3EFFF" />

    <!-- App surfaces -->
    <LinearGradientBrush x:Key="AppWindowBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1A1430" Offset="0.00" />
        <GradientStop Color="#221A3E" Offset="0.50" />
        <GradientStop Color="#1B1533" Offset="1.00" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#241C40" />
    <SolidColorBrush x:Key="AppMainBackground" Color="#D91B1530" />
    <Color x:Key="AppMainBackgroundColor">#1B1531</Color>
    <SolidColorBrush x:Key="TrackListStripeBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TrackListHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TrackListMultiSelectBrush" Color="#40874CF2" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3EFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B9AEDA" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8C82B0" />
    <!-- Fluent foreground brushes, owned here so secondary/tertiary text follows the palette
         (Fluent binds them to its own SystemBase*Color at load; overriding the colours alone
         does nothing). -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F3EFFF" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#B9AEDA" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#8C82B0" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#1FF3EFFF" />
    <Color x:Key="SystemBaseHighColor">#F3EFFF</Color>
    <Color x:Key="SystemBaseMediumHighColor">#F3EFFF</Color>
    <Color x:Key="SystemBaseMediumColor">#B9AEDA</Color>
    <Color x:Key="SystemBaseMediumLowColor">#8C82B0</Color>
    <Color x:Key="SystemBaseLowColor">#1FF3EFFF</Color>

    <!-- System background palette -->
    <Color x:Key="SystemChromeMediumColor">#1B1531</Color>
    <Color x:Key="SystemChromeMediumLowColor">#1B1531</Color>
    <Color x:Key="SystemChromeLowColor">#1B1531</Color>
    <Color x:Key="SystemChromeHighColor">#1B1531</Color>
    <Color x:Key="SystemAltHighColor">#1B1531</Color>
    <Color x:Key="SystemAltMediumColor">#1B1531</Color>
    <Color x:Key="SystemAltMediumHighColor">#1B1531</Color>
    <Color x:Key="SystemAltMediumLowColor">#1B1531</Color>
    <Color x:Key="SystemAltLowColor">#1B1531</Color>
    <Color x:Key="SystemRegionColor">#1B1531</Color>
    <Color x:Key="RegionColor">#1B1531</Color>

    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#2A2148" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeWhiteBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundAltHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundBaseLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundBaseMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundChromeMediumLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemChromeMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemChromeMediumLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemChromeLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemChromeHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemAltHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemAltMediumBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemAltMediumHighBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemAltMediumLowBrush" Color="#1B1531" />
    <SolidColorBrush x:Key="SystemAltLowBrush" Color="#1B1531" />

    <!-- Cards, chips, pills -->
    <SolidColorBrush x:Key="HomeCardBackground" Color="#2A2148" />
    <SolidColorBrush x:Key="HomeCardHoverBackground" Color="#342A58" />
    <SolidColorBrush x:Key="RankGoldBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="RankSilverBrush" Color="#C9CED6" />
    <SolidColorBrush x:Key="RankBronzeBrush" Color="#D68A4F" />
    <SolidColorBrush x:Key="ChipBackground" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ChipHoverBackground" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#33000000" />
    <SolidColorBrush x:Key="GlassPillBackground" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassPillHoverBackground" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="GlassPillPressedBackground" Color="#4AFFFFFF" />
    <SolidColorBrush x:Key="GlassPillBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="InputOutlineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ArtworkPlaceholderBackground" Color="#2E2650" />

    <!-- Playback Island -->
    <SolidColorBrush x:Key="IslandBackground" Color="#F0221A3E" />
    <Color x:Key="IslandBackgroundColor">#221A3E</Color>
    <SolidColorBrush x:Key="IslandBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="IslandForeground" Color="#F3EFFF" />
    <SolidColorBrush x:Key="IslandForegroundSecondary" Color="#B9AEDA" />
    <SolidColorBrush x:Key="IslandForegroundTertiary" Color="#8C82B0" />
    <SolidColorBrush x:Key="IslandIconFill" Color="#F3EFFF" />
    <SolidColorBrush x:Key="IslandSliderFilled" Color="#874CF2" />
    <SolidColorBrush x:Key="IslandSliderUnfilled" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="IslandAlbumArtPlaceholder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="IslandExplicitBadge" Color="#88888888" />
    <SolidColorBrush x:Key="IslandTrackBoxSliderUnfilled" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="IslandIconAccent" Color="#874CF2" />

    <!-- Sidebar + queue drawer -->
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3A2F63" />
    <SolidColorBrush x:Key="SidebarSelectedHoverBrush" Color="#46396F" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="QueueDrawerBackground" Color="#F0221A3E" />
    <SolidColorBrush x:Key="QueueDrawerForeground" Color="#F3EFFF" />
</ResourceDictionary>
