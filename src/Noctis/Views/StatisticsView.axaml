<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:conv="using:Noctis.Converters"
             x:Class="Noctis.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:PercentageToWidthConverter x:Key="PercentageToWidth" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Tab strip (same pill look as the Settings tabs) -->
        <Style Selector="Button.stats-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.stats-tab /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.stats-tab.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>

        <!-- Stat card -->
        <Style Selector="Border.stat-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- Small fact pill (value + label) under the library numbers -->
        <Style Selector="Border.stat-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- One TextBlock (two Runs) per pill with a fixed 14px box: number and label share a
                 baseline, and a label with descenders (Lossy, playlists) can't grow the box. -->
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>

        <!-- Section card -->
        <Style Selector="Border.stats-section">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Header: title + tab strip -->
        <Grid Grid.Row="0" Margin="24,24,36,12" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:T Statistics.ListeningStatistics}"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="stats-tab"
                        Command="{Binding OpenWrapCommand}"
                        ToolTip.Tip="{loc:T Statistics.ListeningRecapTopTracksTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CameraIcon}" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T Statistics.NoctisWrap}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" VerticalAlignment="Center" Margin="2,0"/>
                <Button Classes="stats-tab" Classes.active="{Binding IsOverviewTabSelected}"
                        Command="{Binding SelectTabCommand}" CommandParameter="Overview">
                    <TextBlock Text="{loc:T Statistics.Overview}" FontSize="13" FontWeight="SemiBold"/>
                </Button>
                <Button Classes="stats-tab" Classes.active="{Binding IsHistoryTabSelected}"
                        Command="{Binding SelectTabCommand}" CommandParameter="History">
                    <TextBlock Text="{loc:T Statistics.PlayHistory}" FontSize="13" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Panel Margin="24,4,24,115">

                <!-- ═══════════════ OVERVIEW ═══════════════ -->
                <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTabSelected}">

                    <!-- Listening, the numbers that change: one accent row. -->
                    <UniformGrid Columns="4">
                        <Border Classes="stat-card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding TotalPlays}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{loc:T Statistics.TotalPlays}" FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="stat-card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ListeningTime}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{loc:T Statistics.ListeningTime}" FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="stat-card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CurrentStreakText}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{loc:T Statistics.CurrentStreak}" FontSize="12" Opacity="0.5"/>
                                <TextBlock Text="{Binding LongestStreakSubText}" FontSize="11" Opacity="0.35"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="stat-card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding PlaysThisWeekText}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{loc:T Statistics.PlaysWeek}" FontSize="12" Opacity="0.5"/>
                                <TextBlock Text="{Binding WeekDeltaText}" FontSize="11" Opacity="0.35"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Top Artists / Top Albums -->
                    <Grid ColumnDefinitions="*,16,*">
                        <Border Grid.Column="0" Classes="stats-section" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:T Statistics.TopArtists}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{loc:T Statistics.PlaySomeTracksSee}"
                                           FontSize="13" Opacity="0.4"
                                           IsVisible="{Binding !TopArtists.Count}"/>
                                <ItemsControl ItemsSource="{Binding TopArtists}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:StatItem">
                                            <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                           FontSize="13" FontWeight="SemiBold" Opacity="0.35"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="stats-section" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:T Statistics.TopAlbums}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{loc:T Statistics.PlaySomeTracksSee2}"
                                           FontSize="13" Opacity="0.4"
                                           IsVisible="{Binding !TopAlbums.Count}"/>
                                <ItemsControl ItemsSource="{Binding TopAlbums}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:StatItem">
                                            <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                           FontSize="13" FontWeight="SemiBold" Opacity="0.35"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Library: the static facts in one section — a quiet number row, the format
                         bars, and the audio-quality averages as a pill strip (was 8 tiles + a card). -->
                    <Border Classes="stats-section">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{loc:T Statistics.Library}" FontSize="16" FontWeight="Bold"/>
                            <UniformGrid Columns="4">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding TotalTracks}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:T Statistics.Tracks}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding TotalAlbums}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:T Statistics.Albums}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding TotalArtists}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:T Statistics.Artists}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding TotalDuration}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:T Statistics.TotalDuration}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                            <TextBlock Text="{loc:T Statistics.FormatBreakdown}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                            <TextBlock Text="{loc:T Statistics.NoTracksLibrary}"
                                       FontSize="13" Opacity="0.4"
                                       IsVisible="{Binding !FormatBreakdown.Count}"/>
                            <ItemsControl ItemsSource="{Binding FormatBreakdown}" Margin="0,-6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:StatItem">
                                        <Grid ColumnDefinitions="80,*,Auto" Margin="0,3" Height="24">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Height="12"
                                                    CornerRadius="999" ClipToBounds="True" Margin="8,0"
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding Percentage, Converter={StaticResource PercentageToWidth}, ConverterParameter=400}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                                       MinWidth="110" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,-6">
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LosslessPercentText}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.Lossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding HiResPercentText}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.HiResLossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding AvgSampleRateText}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.AvgSampleRate}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding AvgBitDepthText}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.AvgBitDepth}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding AvgTrackLength}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.AvgLength}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                                <Border Classes="stat-pill">
                                    <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LikedTracks}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Statistics.Liked}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════ PLAY HISTORY ═══════════════ -->
                <StackPanel Spacing="16" IsVisible="{Binding IsHistoryTabSelected}">

                    <!-- Hour-of-day heatmap -->
                    <Border Classes="stats-section">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:T Statistics.ListeningByHour}" FontSize="16" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding HourlyHeatmap}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="24" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:HourHeatCell">
                                        <StackPanel Spacing="4" Margin="1,0">
                                            <Border Height="44" CornerRadius="4"
                                                    Background="{DynamicResource AccentColorBrush}"
                                                    Opacity="{Binding Intensity}"
                                                    ToolTip.Tip="{Binding Tooltip}"/>
                                            <TextBlock Text="{Binding HourLabel}" FontSize="9" Opacity="0.4"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,16,*">
                        <!-- Most skipped -->
                        <Border Grid.Column="0" Classes="stats-section" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:T Statistics.MostSkipped}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{loc:T Statistics.NoSkipsRecordedYet}"
                                           FontSize="13" Opacity="0.4"
                                           IsVisible="{Binding !SkipRates.Count}"/>
                                <ItemsControl ItemsSource="{Binding SkipRates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:StatItem">
                                            <StackPanel Margin="0,5" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                        <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueLabel}"
                                                               FontSize="11" Opacity="0.6"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                                <Border Height="5" CornerRadius="999" ClipToBounds="True"
                                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                    <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                            HorizontalAlignment="Left"
                                                            Width="{Binding Percentage, Converter={StaticResource PercentageToWidth}, ConverterParameter=400}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Forgotten favorites -->
                        <Border Grid.Column="2" Classes="stats-section" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:T Statistics.ForgottenFavorites}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{loc:T Statistics.LovedHighlyRatedTracks}"
                                           FontSize="13" Opacity="0.4" TextWrapping="Wrap"
                                           IsVisible="{Binding !ForgottenFavorites.Count}"/>
                                <ItemsControl ItemsSource="{Binding ForgottenFavorites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:StatItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ValueLabel}"
                                                           FontSize="11" Opacity="0.6"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Chronological play log -->
                    <Border Classes="stats-section">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:T Statistics.RecentPlays}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Statistics.NoPlaysRecordedYet}"
                                       FontSize="13" Opacity="0.4"
                                       IsVisible="{Binding !PlayLog.Count}"/>
                            <ItemsControl ItemsSource="{Binding PlayLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PlayLogItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="13" Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="999" Padding="7,2"
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                    VerticalAlignment="Center" Margin="8,0"
                                                    IsVisible="{Binding Skipped}">
                                                <TextBlock Text="{loc:T Statistics.Skipped}" FontSize="10" Opacity="0.7"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeLabel}"
                                                       FontSize="12" Opacity="0.5" VerticalAlignment="Center"
                                                       MinWidth="110" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Panel>
        </ScrollViewer>
    </Grid>

</UserControl>
