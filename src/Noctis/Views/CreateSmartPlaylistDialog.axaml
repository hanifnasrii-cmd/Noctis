<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:m="using:Noctis.Models"
        xmlns:svc="using:Noctis.Services"
        xmlns:controls="using:Noctis.Controls"
        xmlns:conv="using:Noctis.Converters"
        x:Class="Noctis.Views.CreateSmartPlaylistDialog"
        x:DataType="vm:CreateSmartPlaylistDialogViewModel"
        Title="{loc:T CreateSmartPlaylist.CreateSmartPlaylist}"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:SmartPlaylistDisplayNameConverter x:Key="DisplayName" />
    </Window.Resources>

    <!-- Scoped outlines so input rows + the Cancel pill stay visible on light themes
         where the dialog body and inputs share a (near-)white surface. -->
    <Window.Styles>
        <!-- One outline for every control on a rule row. The Value box gets its white
             1.5px ring from the global TextBox.crisp-input rule, which paints the
             TEMPLATE part (Border#PART_BorderElement) — a Setter on the control's own
             BorderBrush, as this block used to carry, never reached it, so the dropdowns
             and the limit box sat in Fluent's dimmer grey next to a white Value pill.
             These pin the same white on each template's own border part. -->
        <Style Selector="ComboBox.crisp-combo">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <!-- Border#Background is Fluent's ComboBox border; HighlightBackground is the
             focus/press overlay drawn over it, so both need the pill radius or the
             corners square off the moment the dropdown is opened. -->
        <Style Selector="ComboBox.crisp-combo /template/ Border#Background">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="ComboBox.crisp-combo:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="ComboBox.crisp-combo:focus /template/ Border#Background,
                         ComboBox.crisp-combo:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="ComboBox.crisp-combo /template/ Border#HighlightBackground">
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <!-- Pill-shaped hover/selection highlight for the dropdown items, the same recipe
             the Songs View Options sheet uses for its Sort by list. -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <!-- The limit box is a NumericUpDown, so its visible ring is the ButtonSpinner's
             border, not the inner TextBox's (that one is pinned to 0 in Styles.axaml). -->
        <Style Selector="NumericUpDown.limit-pill-number">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="NumericUpDown.limit-pill-number /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown.limit-pill-number /template/ ButtonSpinner#PART_Spinner /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>

        <!-- Until "Limit to" is ticked, both of its controls are switched off. The white
             above is pinned per template part, so Fluent's own disabled chrome never gets a
             look in — each one therefore states its own greyed-out ring here, and they use
             the SAME brush so the pair dims together rather than one staying lit. -->
        <Style Selector="ComboBox.crisp-combo:disabled /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
        </Style>
        <Style Selector="NumericUpDown.limit-pill-number:disabled /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
        </Style>
        <Style Selector="NumericUpDown.limit-pill-number:disabled /template/ ButtonSpinner#PART_Spinner /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
        </Style>
    </Window.Styles>

    <!-- Full-window dimmed overlay that captures all input.
         Starts transparent; code-behind fades it in on open and back out
         before closing (same animation as the Add to Playlist dialog). -->
    <Border x:Name="DialogOverlay"
            Background="#50000000"
            Opacity="0"
            PointerPressed="OnOverlayPointerPressed"
            PointerWheelChanged="OnOverlayWheel">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                    <DoubleTransition.Easing>
                        <CubicEaseOut/>
                    </DoubleTransition.Easing>
                </DoubleTransition>
            </Transitions>
        </Border.Transitions>

        <!-- Centered dialog card -->
        <Border x:Name="DialogCard"
                CornerRadius="24"
                ClipToBounds="True"
                Background="{DynamicResource AppMainBackground}"
                Width="620"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="50%,50%"
                RenderTransform="scale(0.96)"
                BoxShadow="0 8 32 0 #80000000, 0 0 0 1 #33FFFFFF">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Border.Transitions>
            <DockPanel Margin="0">

                <!-- Bottom bar: preview count + Create/Cancel -->
                <Border DockPanel.Dock="Bottom"
                        Padding="24,12,24,16">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" Opacity="0.6">
                            <TextBlock.Text>
                                <Binding Path="MatchingTrackCount" StringFormat="Matches {0} tracks" />
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="2"
                                Content="{loc:T CreateSmartPlaylist.Cancel}"
                                Command="{Binding CancelCommand}"
                                BorderThickness="0"
                                Width="100"
                                Padding="0,8"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                CornerRadius="999"
                                Margin="0,0,8,0"
                                Cursor="Hand" />
                        <Button Grid.Column="3"
                                Content="{loc:T CreateSmartPlaylist.Create}"
                                Command="{Binding CreateCommand}"
                                Width="100"
                                Padding="0,8"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                CornerRadius="999"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Scrollable content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,16" Spacing="14">

                        <!-- Title -->
                        <TextBlock Text="{loc:T CreateSmartPlaylist.CreateSmartPlaylist}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                        <!-- Name + description: same pill inputs as the other playlist dialogs -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <TextBox Text="{Binding PlaylistName}"
                                     Classes="crisp-input"
                                     Watermark="{loc:T CreateSmartPlaylist.PlaylistName}"
                                     CornerRadius="999"
                                     Padding="14,8"
                                     x:Name="NameTextBox" />
                            <TextBlock Text="{loc:T CreateSmartPlaylist.NameRequired}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       IsVisible="{Binding ShowNameRequiredError}" />
                            <TextBox Text="{Binding PlaylistDescription}"
                                     Classes="crisp-input"
                                     Watermark="{loc:T CreateSmartPlaylist.DescriptionOptional}"
                                     CornerRadius="999"
                                     Padding="14,8" />
                        </StackPanel>

                        <!-- Rules header with the match mode inline on the right -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:T CreateSmartPlaylist.Rules}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:T CreateSmartPlaylist.Match}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Opacity="0.7" />
                                <!-- The same switch every Settings row uses (LottieToggle),
                                     not Fluent's ToggleSwitch: its off state is the dark
                                     slate track with a white knob rather than the pale pill
                                     Fluent draws here. LottieToggle carries no On/Off
                                     content, so the label sits beside it. -->
                                <controls:LottieToggle IsChecked="{Binding MatchAll}"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="ALL rules" VerticalAlignment="Center" FontSize="13"
                                           IsVisible="{Binding MatchAll}" />
                                <TextBlock Text="ANY rule" VerticalAlignment="Center" FontSize="13"
                                           IsVisible="{Binding !MatchAll}" />
                            </StackPanel>
                        </Grid>

                        <!-- Rules list -->
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SmartPlaylistRuleViewModel">
                                    <!-- Glide, the Settings sub-block reveal: a new rule slides
                                         out from under Add Rule and a removed one folds away
                                         instead of both popping. Lift/Motion copied from the
                                         Integrations "Show Album on Discord" block. -->
                                    <controls:CollapsibleContent IsOpen="{Binding IsRevealed}" Lift="10" Motion="Glide">
                                    <Border Background="{DynamicResource ChipBackground}" CornerRadius="12" Padding="12" Margin="0,3">
                                        <Grid ColumnDefinitions="*,*,*,Auto">
                                            <!-- Field dropdown -->
                                            <ComboBox Grid.Column="0"
                                                      Classes="crisp-combo"
                                                      ItemsSource="{Binding $parent[Window].((vm:CreateSmartPlaylistDialogViewModel)DataContext).AllFields}"
                                                      SelectedItem="{Binding SelectedField}"
                                                      Margin="0,0,8,0"
                                                      CornerRadius="999"
                                                      Padding="14,0"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="m:RuleField">
                                                        <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Operator dropdown -->
                                            <ComboBox Grid.Column="1"
                                                      Classes="crisp-combo"
                                                      ItemsSource="{Binding AvailableOperators}"
                                                      SelectedItem="{Binding SelectedOperator}"
                                                      Margin="0,0,8,0"
                                                      CornerRadius="999"
                                                      Padding="14,0"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="m:RuleOperator">
                                                        <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Value input(s) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <TextBox Text="{Binding Value}"
                                                         Classes="crisp-input"
                                                         IsVisible="{Binding ShowValueInput}"
                                                         Watermark="{loc:T CreateSmartPlaylist.Value}"
                                                         MinWidth="100"
                                                         CornerRadius="999"
                                                         Padding="12,6"
                                                         VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         HorizontalAlignment="Stretch" />
                                                <TextBox Text="{Binding Value2}"
                                                         Classes="crisp-input"
                                                         IsVisible="{Binding ShowValue2Input}"
                                                         Watermark="{loc:T CreateSmartPlaylist.To}"
                                                         Width="80"
                                                         CornerRadius="999"
                                                         Padding="12,6"
                                                         VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center" />
                                            </StackPanel>

                                            <!-- Remove button -->
                                            <Button Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="999"
                                                    Padding="8,4"
                                                    Margin="4,0,0,0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[Window].((vm:CreateSmartPlaylistDialogViewModel)DataContext).RemoveRuleCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource DismissIcon}" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    </controls:CollapsibleContent>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Rule button — quiet chip so Create stays the only accent action -->
                        <Button Command="{Binding AddRuleCommand}"
                                Background="{DynamicResource ChipBackground}"
                                BorderThickness="0"
                                HorizontalAlignment="Left"
                                Padding="16,7"
                                CornerRadius="999"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource AddIcon}" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T CreateSmartPlaylist.AddRule}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Limit section -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <CheckBox Classes="metadata-pill-checkbox" IsChecked="{Binding HasLimit}" Content="{loc:T CreateSmartPlaylist.Limit}" VerticalAlignment="Center" Padding="4,0,0,0" />
                            <NumericUpDown Value="{Binding LimitCount}"
                                           Minimum="1" Maximum="1000"
                                           IsEnabled="{Binding HasLimit}"
                                           Width="72"
                                           Height="36"
                                           Classes="limit-pill-number"
                                           CornerRadius="999"
                                           ShowButtonSpinner="False"
                                           FormatString="0"
                                           Padding="0"
                                           TextAlignment="Center"
                                           HorizontalContentAlignment="Center"
                                           VerticalAlignment="Center"
                                           VerticalContentAlignment="Center" />
                            <TextBlock Text="{loc:T CreateSmartPlaylist.TracksSortedBy}" VerticalAlignment="Center" FontSize="13" />
                            <ComboBox Classes="crisp-combo"
                                      ItemsSource="{Binding AllSortOptions}"
                                      SelectedItem="{Binding SortBy}"
                                      IsEnabled="{Binding HasLimit}"
                                      Width="160"
                                      CornerRadius="999"
                                      Padding="14,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:SmartPlaylistSortBy">
                                        <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Border>
</Window>
